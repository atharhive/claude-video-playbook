# Claude Video Playbook Environment Configuration
# Copy this file to .env and configure your keys. Do not commit .env to version control.

# ElevenLabs Speech Synthesis (optional: fallback to free edge-tts if unset)
ELEVENLABS_API_KEY=""

# Atlas Cloud API for Vox Explainer multi-model pipelines
ATLASCLOUD_API_KEY=""

# Headless Chromium executable path for server rendering
CHROME_PATH="/home/ubuntu/.hermes/tools/chromium-1208/chrome-linux64/chrome"

# Audio and video rendering concurrency settings
RENDER_CONCURRENCY="1"
AUDIO_SAMPLE_RATE="48000"
